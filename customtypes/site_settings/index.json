{
  "id": "site_settings",
  "label": "Site settings",
  "format": "custom",
  "repeatable": false,
  "status": true,
  "json": {
    "Profile": {
      "name": {
        "type": "Text",
        "config": {
          "label": "Name"
        }
      },
      "role": {
        "type": "Text",
        "config": {
          "label": "Role"
        }
      },
      "description": {
        "type": "StructuredText",
        "config": {
          "label": "Description",
          "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
        }
      },
      "avatar": {
        "type": "Image",
        "config": {
          "label": "Avatar",
          "constraint": {},
          "thumbnails": []
        }
      }
    },
    "Contact": {
      "contact_heading": {
        "type": "Text",
        "config": {
          "label": "Contact heading"
        }
      },
      "contact_email": {
        "type": "Text",
        "config": {
          "label": "Contact email"
        }
      },
      "cv_link": {
        "type": "Link",
        "config": {
          "label": "CV link",
          "select": "web"
        }
      },
      "cv_label": {
        "type": "Text",
        "config": {
          "label": "CV label"
        }
      },
      "linkedin_url": {
        "type": "Link",
        "config": {
          "label": "LinkedIn URL",
          "select": "web"
        }
      },
      "instagram_url": {
        "type": "Link",
        "config": {
          "label": "Instagram URL",
          "placeholder": "",
          "select": null,
          "allowTargetBlank": true,
          "allowText": true,
          "repeat": false
        }
      }
    },
    "Navigation": {
      "navigation_items": {
        "type": "Group",
        "config": {
          "label": "Navigation items",
          "repeat": true,
          "fields": {
            "key": {
              "type": "Select",
              "config": {
                "label": "Key",
                "options": ["about", "blog", "work", "contact"]
              }
            },
            "label": {
              "type": "Text",
              "config": {
                "label": "Label"
              }
            }
          }
        }
      }
    },
    "Blog": {
      "dev_username": {
        "type": "Text",
        "config": {
          "label": "DEV username"
        }
      },
      "blog_title": {
        "type": "Text",
        "config": {
          "label": "Blog title"
        }
      },
      "blog_intro": {
        "type": "Text",
        "config": {
          "label": "Blog intro"
        }
      },
      "blog_empty_message": {
        "type": "Text",
        "config": {
          "label": "Empty blog message"
        }
      },
      "blog_read_on_dev_label": {
        "type": "Text",
        "config": {
          "label": "Read on DEV label"
        }
      },
      "blog_reactions_label": {
        "type": "Text",
        "config": {
          "label": "Reactions label"
        }
      },
      "blog_comments_label": {
        "type": "Text",
        "config": {
          "label": "Comments label"
        }
      }
    },
    "Legacy redirects": {
      "legacy_article_redirects": {
        "type": "Group",
        "config": {
          "label": "Legacy article redirects",
          "repeat": true,
          "fields": {
            "legacy_uid": {
              "type": "Text",
              "config": {
                "label": "Legacy UID"
              }
            },
            "dev_article_url": {
              "type": "Link",
              "config": {
                "label": "DEV article URL",
                "select": "web"
              }
            }
          }
        }
      }
    }
  }
}
