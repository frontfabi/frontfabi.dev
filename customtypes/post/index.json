{
  "id": "post",
  "label": "Blog post",
  "format": "custom",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "URL slug"
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "label": "Title",
          "single": "heading1"
        }
      },
      "excerpt": {
        "type": "Text",
        "config": {
          "label": "Excerpt"
        }
      },
      "published_date": {
        "type": "Date",
        "config": {
          "label": "Publication date"
        }
      },
      "category": {
        "type": "Select",
        "config": {
          "label": "Category",
          "options": ["Front-end", "Carreira", "Comunidade"]
        }
      },
      "body": {
        "type": "StructuredText",
        "config": {
          "label": "Body",
          "multi": "paragraph,heading2,heading3,strong,em,hyperlink,list-item,o-list-item,image,preformatted",
          "allowTargetBlank": true
        }
      },
      "cover": {
        "type": "Image",
        "config": {
          "label": "Cover",
          "thumbnails": []
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta title"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta description"
        }
      }
    }
  }
}
