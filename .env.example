# Optional. The existing repository from slicemachine.config.json remains the default.
NEXT_PUBLIC_PRISMIC_ENVIRONMENT=frontfabi
NEXT_PUBLIC_SITE_URL=https://frontfabi.dev
# Optional. GA4 measurement ID; analytics stays disabled until this is set.
NEXT_PUBLIC_GA_ID=

# Mural GitHub. Create an OAuth App at github.com/settings/developers with
# callback https://frontfabi.dev/api/auth/callback/github.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=
DATABASE_URL=
